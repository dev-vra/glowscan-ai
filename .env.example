# Supabase (Project Settings → API / Database)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Pooler transação (runtime, porta 6543) e sessão/direta (migrations, porta 5432)
DATABASE_URL=
DIRECT_URL=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# IA (Vercel AI Gateway)
AI_GATEWAY_API_KEY=
AI_VISION_MODEL=anthropic/claude-sonnet-5.5

# Stripe (modo teste até o deploy)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Afiliados (opcional): tag do Amazon Associados
AFFILIATE_AMAZON_TAG=

# Só local: pula o paywall sem Stripe (ignorado em produção)
BILLING_BYPASS=false
