    "\\bacompanhar\\b"
   ]
  },
  {
   "id": "conflicts",
   "label": "Combinação/conflito de ingredientes",
   "kind": "request",
   "patterns": [
    "\\bconflict",
    "\\bmix(ing)?\\b",
    "\\bcombin",
    "\\binteract",
    "\\btogether\\b",
    "\\bmisturar\\b",
    "\\bjuntos?\\b",
    "\\bcombinar\\b"
   ]
  },
  {
   "id": "routine_reminders",
   "label": "Rotina/lembretes",
   "kind": "request",
   "patterns": [
    "\\broutine\\b",
    "\\breminder",
